# Google Cloud Vertex AI (recommended for Gemini models with clinical content)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Alternative: Google AI Studio (may block medical content due to safety filters)
# GOOGLE_API_KEY=AIzaSy...

# Anthropic (for Claude models — direct API)
# CLAUDE_API_KEY=sk-ant-...

# Anthropic via AWS Bedrock (alternative to direct API)
# Set CLAUDE_PROVIDER=bedrock to route Claude calls through Bedrock
# CLAUDE_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# OpenAI (for GPT models)
# OPENAI_API_KEY=sk-proj-...

# CDISC API (optional, for CORE conformance validation)
# CDISC_API_KEY=...
